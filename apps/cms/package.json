{
  "name": "@tom/cms",
  "version": "0.0.1",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "deploy": "pnpm run deploy:database && pnpm run deploy:app",
    "deploy:app": "opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --env=$CLOUDFLARE_ENV --remote",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3200",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3200",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "generate:types:cloudflare & generate:types:payload & wait",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm install --filter @tom/cms",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation oxlint",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation oxlint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && pnpm install --filter @tom/cms",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3200"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.17.1",
    "@payloadcms/admin-bar": "3.75.0",
    "@payloadcms/db-d1-sqlite": "catalog:",
    "@payloadcms/live-preview-react": "3.75.0",
    "@payloadcms/next": "catalog:",
    "@payloadcms/payload-cloud": "3.75.0",
    "@payloadcms/plugin-form-builder": "3.75.0",
    "@payloadcms/plugin-nested-docs": "3.75.0",
    "@payloadcms/plugin-redirects": "3.75.0",
    "@payloadcms/plugin-search": "3.75.0",
    "@payloadcms/plugin-seo": "3.75.0",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/storage-s3": "3.75.0",
    "@payloadcms/ui": "3.75.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "dotenv": "catalog:",
    "geist": "1.5.1",
    "graphql": "catalog:",
    "jose": "5.9.6",
    "lucide-react": "0.378.0",
    "next": "catalog:",
    "next-sitemap": "4.2.3",
    "payload": "catalog:",
    "prism-react-renderer": "2.4.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.45.4",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "1.0.4",
    "@types/node": "22.5.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.23",
    "copyfiles": "2.4.1",
    "eslint": "catalog:",
    "eslint-config-next": "16.1.7",
    "jsdom": "26.1.0",
    "postcss": "catalog:",
    "prettier": "3.7.4",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.6",
    "wrangler": "4.76.0"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
