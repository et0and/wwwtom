{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Stryker 10 + vitest 4.1.10. Mutates src/ (.ts and .tsx); tests in src/**/__tests__/ plus the jsdom setup file are excluded from mutation and discovered via the vitest config.",
  "packageManager": "pnpm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "related": true
  },
  "coverageAnalysis": "perTest",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/__tests__/**",
    "!src/test/**",
    "!src/components/CameraRoll.tsx",
    "!src/components/Arena.tsx",
    "!src/components/BlurInSection.tsx",
    "!src/components/BlurInText.tsx",
    "!src/libs/haptics.ts",
    "!src/libs/adapter.ts",
    "!src/libs/utils/blurhash.ts",
    "!src/libs/query-client.ts",
    "!src/libs/query-dehydration.ts",
    "!src/routes/purchase/**",
    "!src/routes/work/wwwork/**",
    "!src/routes/guestbook.tsx",
    "!src/routes/feed.xml.ts",
    "!src/routes/sitemap.xml.ts",
    "!src/routes/products.tsx",
    "!src/routes/worktable.tsx",
    "!src/routes/thanks.tsx",
    "!src/routes/index.tsx",
    "!src/routes/about.tsx",
    "!src/routes/accessibility.tsx",
    "!src/routes/\\[...404\\].tsx",
    "!src/routes/posts/**",
    "!src/routes/work/**",
    "!src/entry-client.tsx",
    "!src/entry-server.tsx",
    "!src/app.tsx"
  ],
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/reports/**"]
}
