{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.staging.config.ts",
    "playwright.editor.config.ts",
    "server/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests-editor/**/*.ts",
    "tests-staging/**/*.ts"
  ]
}
