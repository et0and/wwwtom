---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  getContent,
  localePaths,
  otherLocale,
  type Locale,
} from "../i18n/content";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const { locale = "en" } = Astro.props;
const copy = getContent(locale);
const {
  title = copy.meta.title,
  description = copy.meta.description,
} = Astro.props;
const alternate = otherLocale(locale);
const origin = Astro.site ?? new URL("https://slate.tom.so");
const canonical = new URL(Astro.url.pathname, origin);
const englishUrl = new URL(localePaths.en, origin);
const japaneseUrl = new URL(localePaths.ja, origin);
const ogImage = new URL("/screens/readme-workstation.jpg", origin);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={copy.meta.ogImageAlt} />
    <meta property="og:locale" content={copy.meta.ogLocale} />
    <meta property="og:locale:alternate" content={getContent(alternate).meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
