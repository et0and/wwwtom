---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { features, links, showcase, themes, useCases } from "../data/site";
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">The workstation for photographs.</h1>
    <p class="lede">
      Cull, colour, rename, convert, storyboard and deliver in one local-first
      app.
    </p>

    <div class="hero-actions">
      <div class="download-group">
        <a class="download-button" href={links.releases}>
          <Icon name="download" size={20} />
          Download Slate
        </a>
        <div class="download-meta">
          <strong>Free and open source</strong>
          <span>macOS · Windows · Linux</span>
        </div>
      </div>
      <a class="watch-link" href="#workstation">
        See the workstation
        <span class="play-circle"><Icon name="play" size={16} /></span>
      </a>
    </div>

    <div class="hero-frame">
      <img
        src="/screens/readme-workstation.jpg"
        alt="Slate photo workstation with the library and photo inspector"
      />
    </div>

  </section>

  <section id="workstation" class="section container" aria-labelledby="workstation-title">
    <h2 id="workstation-title" class="section-intro">
      One workspace. Every pass.
    </h2>
    <div class="feature-grid">
      {features.map((feature) => (
        <article class="feature-card">
          <Icon name={feature.icon} size={26} />
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="themes" class="theme-section container" data-carousel aria-labelledby="themes-title">
    <div class="theme-head">
      <div>
        <span class="eyebrow"><Icon name="palette" size={16} /> Themes</span>
        <h2 id="themes-title" class="section-intro">
          A workspace that fits the room.
        </h2>
      </div>
      <div class="carousel-controls">
        <button
          class="carousel-button"
          type="button"
          aria-label="Previous theme"
          data-carousel-prev
        >
          <Icon name="chevron-left" size={20} />
        </button>
        <button
          class="carousel-button"
          type="button"
          aria-label="Next theme"
          data-carousel-next
        >
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </div>

    <div class="theme-track" data-carousel-track>
      {themes.map((theme) => (
        <figure
          class="theme-slide"
          style={`--theme-bg: ${theme.background};`}
          data-carousel-item
        >
          <img src={theme.src} alt={theme.alt} loading="lazy" />
        </figure>
      ))}
    </div>

    <div class="theme-dots" data-carousel-dots>
      {themes.map((theme, index) => (
        <button
          class={index === 0 ? "theme-dot is-active" : "theme-dot"}
          type="button"
          aria-label={`Show the ${theme.name} theme`}
          data-carousel-dot={index}
        />
      ))}
    </div>
  </section>

  <section id="why" class="showcase-section" data-carousel aria-labelledby="showcase-title">
    <div class="container">
      <div class="showcase-head">
        <div>
          <span class="eyebrow"><Icon name="spark" size={16} /> A DAW for photographs</span>
          <h2 id="showcase-title" class="section-intro">
            The whole edit, in one window.
          </h2>
        </div>
        <div class="carousel-controls">
          <button
            class="carousel-button"
            type="button"
            aria-label="Previous cards"
            data-carousel-prev
          >
            <Icon name="chevron-left" size={20} />
          </button>
          <button
            class="carousel-button"
            type="button"
            aria-label="Next cards"
            data-carousel-next
          >
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
      </div>

      <div class="showcase-track" id="showcase-track" data-carousel-track>
        <article class="showcase-card green">
          <div>
            <span class="showcase-label"><Icon name={showcase[0].icon} size={26} /> {showcase[0].eyebrow}</span>
            <h3>{showcase[0].title}</h3>
            <p>{showcase[0].body}</p>
          </div>
          <div class="mock" aria-hidden="true">
            <div class="select-row"><span class="select-thumb"></span><span class="select-name">landscape-01.jpg</span><span class="select-stars">★★★★★</span></div>
            <div class="select-row"><span class="select-thumb"></span><span class="select-name">portrait-02.jpg</span><span class="select-stars">★★★★☆</span></div>
            <div class="select-row"><span class="select-thumb"></span><span class="select-name">landscape-05.jpg</span><span class="select-stars">★★★★★</span></div>
            <div class="select-row"><span class="select-thumb"></span><span class="select-name">portrait-04.jpg</span><span class="select-stars">★★★★☆</span></div>
          </div>
        </article>

        <article class="showcase-card orange">
          <div>
            <span class="showcase-label"><Icon name={showcase[1].icon} size={26} /> {showcase[1].eyebrow}</span>
            <h3>{showcase[1].title}</h3>
            <p>{showcase[1].body}</p>
          </div>
          <div class="mock" aria-hidden="true">
            <div class="slider-mock">
              <div class="slider-line"><span>Exposure</span><span class="slider-track" style="--fill: 62%"></span><em>+0.35</em></div>
              <div class="slider-line"><span>Contrast</span><span class="slider-track" style="--fill: 58%"></span><em>+12</em></div>
              <div class="slider-line"><span>Warmth</span><span class="slider-track" style="--fill: 54%"></span><em>+4</em></div>
              <div class="slider-line"><span>Curve</span><span class="slider-track" style="--fill: 48%"></span><em>S</em></div>
            </div>
          </div>
        </article>

        <article class="showcase-card blue">
          <div>
            <span class="showcase-label"><Icon name={showcase[2].icon} size={26} /> {showcase[2].eyebrow}</span>
            <h3>{showcase[2].title}</h3>
            <p>{showcase[2].body}</p>
          </div>
          <div class="mock rename-mock" aria-hidden="true">
            <div class="rename-row"><span>IMG_0001.jpg</span><span>walk-001.jpg</span></div>
            <div class="rename-row"><span>IMG_0002.jpg</span><span>walk-002.jpg</span></div>
            <div class="rename-row"><span>IMG_0003.jpg</span><span>walk-003.jpg</span></div>
          </div>
        </article>

        <article class="showcase-card pink">
          <div>
            <span class="showcase-label"><Icon name={showcase[3].icon} size={26} /> {showcase[3].eyebrow}</span>
            <h3>{showcase[3].title}</h3>
            <p>{showcase[3].body}</p>
          </div>
          <div class="mock" aria-hidden="true">
            <div class="sheet-mock">
              <span class="sheet-tile"></span><span class="sheet-tile"></span><span class="sheet-tile"></span>
              <span class="sheet-tile"></span><span class="sheet-tile"></span><span class="sheet-tile"></span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="usecase-section container" aria-labelledby="usecase-title">
    <div class="usecase-copy">
      <h2 id="usecase-title">What will you make?</h2>
      <p>A folder, a shoot, an archive. Start there.</p>
    </div>
    <div class="usecase-grid">
      {useCases.map((item) => (
        <article class="usecase-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <script>
    const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

    carousels.forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
      if (!track) return;

      const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const dots = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
      );
      const items = Array.from(
        track.querySelectorAll<HTMLElement>("[data-carousel-item]"),
      );
      const gap =
        Number.parseFloat(getComputedStyle(track).columnGap) ||
        Number.parseFloat(getComputedStyle(track).gap) ||
        0;
      const step = items[0] ? items[0].getBoundingClientRect().width + gap : 340;

      previous?.addEventListener("click", () => {
        track.scrollBy({ left: -step, behavior: "smooth" });
      });
      next?.addEventListener("click", () => {
        track.scrollBy({ left: step, behavior: "smooth" });
      });

      if (dots.length) {
        const syncDots = () => {
          const trackLeft = track.getBoundingClientRect().left;
          let active = 0;
          let closest = Number.POSITIVE_INFINITY;

          items.forEach((item, index) => {
            const distance = Math.abs(item.getBoundingClientRect().left - trackLeft);
            if (distance < closest) {
              closest = distance;
              active = index;
            }
          });

          dots.forEach((dot, index) => {
            dot.classList.toggle("is-active", index === active);
          });
        };

        track.addEventListener(
          "scroll",
          () => requestAnimationFrame(syncDots),
          { passive: true },
        );
        syncDots();

        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
            const item = items[index];
            if (!item) return;
            const left =
              track.scrollLeft +
              item.getBoundingClientRect().left -
              track.getBoundingClientRect().left;
            track.scrollTo({ left, behavior: "smooth" });
          });
        });
      }
    });
  </script>
</Base>
