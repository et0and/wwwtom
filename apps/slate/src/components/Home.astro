---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { links } from "../data/site";
import { getContent, type Locale } from "../i18n/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero, features, noLimits, themes } = getContent(locale);
// Placeholder until the Slate demo video is ready.
const videoEmbed = "https://www.youtube-nocookie.com/embed/aqz-KE-bpKQ?autoplay=1&rel=0";
---
<Base locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">
      {hero.titleLines.map((line) => <span class="hero-line">{line}</span>)}
    </h1>
    <p class="lede">{hero.lede}</p>

    <div class="hero-actions">
      <div class="download-group">
        <a class="download-button" href={links.releases}>
          <Icon name="download" size={20} />
          {hero.download}
        </a>
        <div class="download-meta">
          <strong>{hero.free}</strong>
          <span>{hero.platforms}</span>
        </div>
      </div>
      <button class="watch-link" type="button" data-video-open aria-haspopup="dialog">
        {hero.watch}
        <span class="play-circle"><Icon name="play" size={16} /></span>
      </button>
    </div>

    <div class="hero-frame">
      <img src="/screens/readme-workstation.jpg" alt={hero.imageAlt} />
    </div>
  </section>

  <section
    id="workstation"
    class="section container"
    aria-labelledby="workstation-title"
  >
    <h2 id="workstation-title" class="section-intro">{features.title}</h2>
    <div class="feature-grid">
      {features.items.map((feature) => (
        <article class="feature-card">
          <Icon name={feature.icon} size={26} />
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="no-limits container" aria-labelledby="no-limits-title">
    <h2 id="no-limits-title">{noLimits.title}</h2>
    <p>{noLimits.body}</p>
  </section>

  <section
    id="themes"
    class="theme-section container"
    data-carousel
    aria-labelledby="themes-title"
  >
    <div class="theme-head">
      <div>
        <span class="eyebrow"><Icon name="palette" size={16} /> {themes.eyebrow}</span>
        <h2 id="themes-title" class="section-intro">{themes.title}</h2>
      </div>
      <div class="carousel-controls">
        <button
          class="carousel-button"
          type="button"
          aria-label={themes.previous}
          data-carousel-prev
        >
          <Icon name="chevron-left" size={20} />
        </button>
        <button
          class="carousel-button"
          type="button"
          aria-label={themes.next}
          data-carousel-next
        >
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </div>

    <div class="theme-track" data-carousel-track>
      {themes.items.map((theme) => (
        <figure
          class="theme-slide"
          style={`--theme-bg: ${theme.background};`}
          data-carousel-item
        >
          <img src={theme.src} alt={theme.alt} loading="lazy" />
        </figure>
      ))}
    </div>

    <div class="theme-dots" data-carousel-dots>
      {themes.items.map((theme, index) => (
        <button
          class={index === 0 ? "theme-dot is-active" : "theme-dot"}
          type="button"
          aria-label={themes.dotLabel(theme.name)}
          data-carousel-dot={index}
        />
      ))}
    </div>
  </section>

  <dialog class="video-modal" data-video-dialog aria-labelledby="video-title">
    <div class="video-modal-inner">
      <div class="video-modal-head">
        <h2 id="video-title">{hero.watch}</h2>
        <button
          class="video-modal-close"
          type="button"
          aria-label={hero.videoClose}
          data-video-close
        >
          <Icon name="close" size={18} />
        </button>
      </div>
      <div class="video-frame">
        <iframe
          data-video-frame
          data-src={videoEmbed}
          title={hero.watch}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </dialog>

  <script>
    const videoDialog = document.querySelector<HTMLDialogElement>("[data-video-dialog]");
    const videoOpen = document.querySelector<HTMLButtonElement>("[data-video-open]");
    const videoClose = document.querySelector<HTMLButtonElement>("[data-video-close]");
    const videoFrame = document.querySelector<HTMLIFrameElement>("[data-video-frame]");

    if (videoDialog && videoOpen && videoFrame) {
      const videoSrc = videoFrame.dataset.src;

      videoOpen.addEventListener("click", () => {
        if (videoSrc) videoFrame.src = videoSrc;
        document.documentElement.classList.add("video-open");
        videoDialog.showModal();
      });

      videoClose?.addEventListener("click", () => videoDialog.close());

      videoDialog.addEventListener("click", (event) => {
        if (event.target === videoDialog) videoDialog.close();
      });

      videoDialog.addEventListener("close", () => {
        videoFrame.removeAttribute("src");
        document.documentElement.classList.remove("video-open");
      });
    }
  </script>

  <script>
    const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

    carousels.forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
      if (!track) return;

      const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
      const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const dots = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
      );
      const items = Array.from(
        track.querySelectorAll<HTMLElement>("[data-carousel-item]"),
      );
      const gap =
        Number.parseFloat(getComputedStyle(track).columnGap) ||
        Number.parseFloat(getComputedStyle(track).gap) ||
        0;
      const step = items[0] ? items[0].getBoundingClientRect().width + gap : 340;

      previous?.addEventListener("click", () => {
        track.scrollBy({ left: -step, behavior: "smooth" });
      });
      next?.addEventListener("click", () => {
        track.scrollBy({ left: step, behavior: "smooth" });
      });

      if (dots.length) {
        const syncDots = () => {
          const trackLeft = track.getBoundingClientRect().left;
          let active = 0;
          let closest = Number.POSITIVE_INFINITY;

          items.forEach((item, index) => {
            const distance = Math.abs(item.getBoundingClientRect().left - trackLeft);
            if (distance < closest) {
              closest = distance;
              active = index;
            }
          });

          dots.forEach((dot, index) => {
            dot.classList.toggle("is-active", index === active);
          });
        };

        track.addEventListener(
          "scroll",
          () => requestAnimationFrame(syncDots),
          { passive: true },
        );
        syncDots();

        dots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
            const item = items[index];
            if (!item) return;
            const left =
              track.scrollLeft +
              item.getBoundingClientRect().left -
              track.getBoundingClientRect().left;
            track.scrollTo({ left, behavior: "smooth" });
          });
        });
      }
    });
  </script>
</Base>
