{
  "name": "@tom/icons",
  "version": "0.0.1",
  "private": true,
  "description": "Phosphor icons as type-safe Solid 2.0 components",
  "type": "module",
  "exports": {
    "./IconBase": "./src/IconBase.tsx",
    "./types": "./src/types.ts",
    "./social/*": "./src/social/*.tsx",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@solidjs/web": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "catalog:",
    "@testing-library/jest-dom": "6.8.0",
    "@types/node": "^26.2.0",
    "jsdom": "27.0.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "catalog:"
  }
}
