{
  "name": "@tom/monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/@tom/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@tom/web",
    "dev:api": "turbo run dev --filter=@tom/api",
    "lint": "turbo run lint",
    "format": "oxfmt --check .",
    "write": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deploy": "turbo run build --filter=@tom/web && cd apps/web && wrangler deploy",
    "deploy:api": "turbo run deploy --filter=@tom/api",
    "deploy:infra": "cd infra && npm run up",
    "preview:infra": "cd infra && npm run preview",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@effect/language-service": "^0.56.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.13.0",
    "semantic-release": "^24.2.3",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.4"
}
