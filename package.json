{
  "name": "@tom/monorepo",
  "private": true,
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint && husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@tom/web",
    "dev:sophie": "turbo run dev --filter=@tom/sophie",
    "dev:editor": "turbo run dev --filter=@tom/editor",
    "dev:api": "pnpm --filter @tom/infra run dev:api",
    "dev:adapter": "pnpm --filter @tom/infra run dev:adapter",
    "lint": "turbo run lint",
    "format": "oxfmt --check .",
    "write": "oxfmt --write .",
    "workflows": "pnpm --filter @tom/workflows generate && oxfmt --write .github/workflows .github/actions",
    "typecheck": "turbo run typecheck",
    "test": "echo 'Running vitest via turbo...' && turbo run test",
    "test:update": "cd apps/web && npx vitest run --update && cd ../../packages/utils && npx vitest run --update && cd ../icons && npx vitest run --update && cd ../workflows && npx vitest run --update",
    "deploy": "pnpm run deploy:shared && pnpm run deploy:turbo && pnpm run deploy:api && pnpm run deploy:adapter && pnpm run deploy:web && pnpm run deploy:sophie",
    "deploy:shared": "pnpm --filter @tom/infra run deploy:shared",
    "deploy:web": "pnpm --filter @tom/infra run deploy:web",
    "deploy:sophie": "pnpm --filter @tom/infra run deploy:sophie",
    "deploy:api": "pnpm --filter @tom/infra run deploy:api",
    "deploy:adapter": "pnpm --filter @tom/infra run deploy:adapter",
    "deploy:runner": "pnpm --filter @tom/infra run deploy:runner",
    "deploy:storybook": "pnpm --filter @tom/infra run deploy:storybook",
    "deploy:turbo": "pnpm --filter @tom/infra run deploy:turbo",
    "destroy": "pnpm run destroy:web && pnpm run destroy:adapter && pnpm run destroy:api && pnpm run destroy:turbo && pnpm run destroy:shared",
    "destroy:shared": "pnpm --filter @tom/infra run destroy",
    "destroy:turbo": "pnpm --filter @tom/infra run destroy:turbo",
    "destroy:api": "pnpm --filter @tom/infra run destroy:api",
    "destroy:adapter": "pnpm --filter @tom/infra run destroy:adapter",
    "destroy:storybook": "pnpm --filter @tom/infra run destroy:storybook",
    "destroy:web": "pnpm --filter @tom/infra run destroy:web",
    "semantic-release": "semantic-release",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish --no-git",
    "destroy:editor": "pnpm --filter @tom/infra run destroy:editor",
    "destroy:sophie": "pnpm --filter @tom/infra run destroy:sophie"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "1.78.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@turbo/gen": "2.8.5",
    "husky": "^9.1.7",
    "oxfmt": "0.50.0",
    "oxlint": "1.78.0",
    "semantic-release": "24.2.3",
    "turbo": "2.9.1",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.3.0"
}
