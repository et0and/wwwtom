{
  "name": "@tom/monorepo",
  "private": true,
  "scripts": {
    "prepare": "effect-language-service patch",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@tom/web",
    "dev:api": "turbo run dev --filter=@tom/api",
    "dev:cms": "turbo run dev --filter=@tom/cms",
    "dev:sophie": "turbo run dev --filter=@tom/sophie",
    "lint": "turbo run lint",
    "format": "oxfmt --check .",
    "write": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "echo 'Running vitest via turbo...' && turbo run test",
    "test:update": "cd apps/web && npx vitest run --update && cd ../../packages/@tom/utils && npx vitest run --update",
    "deploy:web": "turbo run build --filter=@tom/web && cd apps/web && wrangler deploy",
    "deploy:cms": "cd apps/cms && opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:sophie": "cd apps/sophie && opennextjs-cloudflare build --env=$CLOUDFLARE_ENV && opennextjs-cloudflare deploy --env=$CLOUDFLARE_ENV",
    "deploy:api": "turbo run deploy --filter=@tom/api",
    "semantic-release": "semantic-release",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish --no-git"
  },
  "dependencies": {
    "@aredotna/sdk": "0.0.4",
    "solid-motionone": "1.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@effect/language-service": "0.86.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@turbo/gen": "2.8.5",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "semantic-release": "24.2.3",
    "turbo": "2.9.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "catalogs": {
      "default": {
        "effect": "3.19.5",
        "kysely": "0.28.9",
        "postgres": "3.4.7",
        "hono": "4.11.3",
        "solid-js": "1.9.5",
        "@solidjs/meta": "0.29.4",
        "@solidjs/router": "0.15.0",
        "classnames": "2.5.1",
        "obscenity": "0.4.5",
        "next": "16.1.7",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "payload": "3.75.0",
        "@payloadcms/next": "3.75.0",
        "@payloadcms/db-d1-sqlite": "3.75.0",
        "@payloadcms/richtext-lexical": "3.75.0",
        "@payloadcms/storage-r2": "3.75.0",
        "dotenv": "16.4.7",
        "@types/react": "19.2.9",
        "@types/react-dom": "19.2.3",
        "graphql": "16.12.0",
        "postcss": "8.5.8",
        "eslint": "9.39.2",
        "@playwright/test": "1.58.2"
      }
    }
  }
}
