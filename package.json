{
  "name": "@tom/monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/@tom/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "oxfmt --check .",
    "write": "oxfmt --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "deploy": "turbo build --filter=@tom/web && cd apps/web && wrangler deploy"
  },
  "devDependencies": {
    "@effect/language-service": "^0.56.0",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.13.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.4"
}
