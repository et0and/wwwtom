{
  "name": "@tom/monorepo",
  "private": true,
  "scripts": {
    "prepare": "effect-language-service patch && husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@tom/web",
    "dev:api": "pnpm --filter @tom/infra run dev:api",
    "dev:adapter": "pnpm --filter @tom/infra run dev:adapter",
    "dev:cms": "turbo run dev --filter=@tom/cms",
    "dev:sophie": "turbo run dev --filter=@tom/sophie",
    "lint": "turbo run lint",
    "format": "oxfmt --check .",
    "write": "oxfmt --write .",
    "typecheck": "turbo run typecheck",
    "test": "echo 'Running vitest via turbo...' && turbo run test",
    "test:update": "cd apps/web && npx vitest run --update && cd ../../packages/@tom/utils && npx vitest run --update",
    "deploy": "pnpm run deploy:shared && pnpm run deploy:api && pnpm run deploy:adapter && pnpm run deploy:web && pnpm run deploy:cms && pnpm run deploy:sophie",
    "deploy:shared": "pnpm --filter @tom/infra run deploy:shared",
    "deploy:web": "pnpm --filter @tom/infra run deploy:web",
    "deploy:cms": "pnpm --filter @tom/infra run deploy:cms",
    "deploy:sophie": "pnpm --filter @tom/infra run deploy:sophie",
    "deploy:api": "pnpm --filter @tom/infra run deploy:api",
    "deploy:adapter": "pnpm --filter @tom/infra run deploy:adapter",
    "destroy": "pnpm run destroy:sophie && pnpm run destroy:cms && pnpm run destroy:web && pnpm run destroy:adapter && pnpm run destroy:api && pnpm run destroy:shared",
    "destroy:shared": "pnpm --filter @tom/infra run destroy",
    "destroy:api": "pnpm --filter @tom/infra run destroy:api",
    "destroy:adapter": "pnpm --filter @tom/infra run destroy:adapter",
    "destroy:web": "pnpm --filter @tom/infra run destroy:web",
    "destroy:cms": "pnpm --filter @tom/infra run destroy:cms",
    "destroy:sophie": "pnpm --filter @tom/infra run destroy:sophie",
    "semantic-release": "semantic-release",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish --no-git"
  },
  "dependencies": {
    "@aredotna/sdk": "0.0.4",
    "@elysiajs/eden": "1.4.9",
    "elysia": "1.4.29",
    "solid-motionone": "1.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@effect/language-service": "0.86.1",
    "@oxlint/plugins": "1.78.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@turbo/gen": "2.8.5",
    "husky": "^9.1.7",
    "oxfmt": "0.50.0",
    "oxlint": "1.78.0",
    "semantic-release": "24.2.3",
    "turbo": "2.9.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.3.0"
}
