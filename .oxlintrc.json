{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./.oxlint/plugins/tom.mjs",
    {
      "name": "anti-slop",
      "specifier": "./.oxlint/anti-slop/index.ts"
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "tom/no-barrel-file": "error",
    "tom/no-re-export": "error",
    "complexity": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-hand-rolled-retry-loop": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-let": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-redundant-button-type": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, unknown>": "Record<string, unknown> drops all type information. Model the shape with an Effect Schema instead.",
          "Record<string, any>": "Record<string, any> drops all type information. Model the shape with an Effect Schema instead."
        }
      }
    ]
  },
  "ignorePatterns": [
    "**/worker-configuration.d.ts",
    "**/cloudflare-env.d.ts",
    "**/.stryker-tmp/**",
    "**/reports/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/.agents/**"
  ],
  "overrides": [
    {
      "files": [".oxlint/**/*"],
      "rules": {
        "complexity": ["error", 30],
        "anti-slop/no-let": "off"
      }
    },
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "rules": {
        "anti-slop/no-let": "off"
      }
    },
    {
      "files": [
        "apps/adapter/src/arena/get-arena-frame-image.ts",
        "apps/api/src/cms/shared.ts",
        "apps/editor/src/editor/EditorView.tsx",
        "apps/web/src/content/AttachmentMedia.tsx",
        "apps/web/src/garden/GardenPlayer.tsx",
        "apps/web/src/garden/engine.ts",
        "apps/web/src/garden/generators/canon.ts",
        "apps/web/src/garden/rng.ts",
        "apps/web/src/routes/work/wwwork/hold.tsx",
        "apps/web/src/routes/work/wwwork/kawara.tsx",
        "infra/turbo/src/index.ts",
        "packages/ui/src/ViewTransitions.tsx",
        "packages/ui/src/components/checkbox/checkbox.tsx",
        "packages/ui/src/components/dropdown/dropdown.tsx",
        "packages/ui/src/components/radio/radio.tsx",
        "packages/ui/src/components/select/select.tsx",
        "packages/ui/src/components/switch/switch.tsx",
        "packages/ui/src/components/toast/toast.tsx",
        "packages/ui/src/components/tooltip/tooltip.tsx",
        "packages/ui/src/utils/dismissable.ts",
        "packages/ui/src/utils/focus.ts"
      ],
      "rules": {
        "anti-slop/no-let": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
