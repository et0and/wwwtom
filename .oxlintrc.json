{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./.oxlint/plugins/tom.mjs",
    {
      "name": "anti-slop",
      "specifier": "./.oxlint/anti-slop/index.ts"
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "tom/no-barrel-file": "error",
    "tom/no-re-export": "error",
    "complexity": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, unknown>": "Record<string, unknown> drops all type information. Model the shape with an Effect Schema instead.",
          "Record<string, any>": "Record<string, any> drops all type information. Model the shape with an Effect Schema instead."
        }
      }
    ]
  },
  "ignorePatterns": [
    "**/worker-configuration.d.ts",
    "**/cloudflare-env.d.ts",
    "**/.stryker-tmp/**",
    "**/reports/**",
    "**/.turbo/**",
    "**/dist/**",
    "**/.agents/**"
  ],
  "overrides": [
    {
      "files": [".oxlint/**/*"],
      "rules": {
        "complexity": ["error", 30]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
